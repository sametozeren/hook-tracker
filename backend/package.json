  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start:api": "node src/api/server.js",
    "start:worker": "node src/worker/worker.js",
    "start:jobs": "node src/jobs/scheduler.js",
    "start:receiver": "node src/demo-receiver/server.js",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "lint": "eslint .",
